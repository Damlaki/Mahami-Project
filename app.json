{
  "expo": {
    "name": "Mahami",
    "slug": "mahami-planner",
    "scheme": "mahami",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4EF",
    "android": {
      "package": "com.mahami.planner",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9cb44391-14d6-4d1a-a9f8-c5bcd4184f20"
      }
    }
  }
}
