  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install react react-dom react-native expo-router expo-linking expo-constants expo-status-bar expo-splash-screen expo-system-ui expo-font react-native-safe-area-context react-native-screens @react-native-async-storage/async-storage @expo/vector-icons @expo-google-fonts/cairo @react-native-community/datetimepicker",
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test tests/date.test.ts tests/task.test.ts tests/import-and-prefs.test.ts",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
